# Supabase — proyecto compartido de LocalIA (ukhfaphloxlszomccgde).
# NEXT_PUBLIC_* son seguras para el navegador (clave anon, sujeta a RLS).
# La service role NUNCA debe usarse desde el navegador ni exponerse en NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Identificador público del tenant La Osa en la tabla `clientes.site_key`.
# Es seguro exponerlo (es la vía pública de acceso, ya filtrada server-side
# por las funciones RPC), pero NUNCA se usa como tenant_id de confianza.
NEXT_PUBLIC_LAOSA_SITE_KEY=

# id interno (clientes.id) de La Osa. Solo se usa en /admin (autenticado)
# para las RPC de administración; no es un secreto, pero tampoco es la vía
# pública (esa es site_key) — no se usa nunca para autorizar nada por sí solo.
NEXT_PUBLIC_LAOSA_CLIENTE_ID=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# URL pública del sitio (SEO, Open Graph, callbacks de Stripe, QR)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fidelización — avisos automáticos (email/WhatsApp) al otorgar un premio.
# Sin estas claves, los premios se siguen registrando y son gestionables a
# mano desde /admin/fidelizacion; simplemente no se envía el aviso.
# Secreto que verifica las llamadas entrantes al webhook de Supabase
# (restaurant.notificar_premio_otorgado) y al cron de reintento.
PROMO_WEBHOOK_SECRET=
# Resend (email) — https://resend.com
RESEND_API_KEY=
RESEND_FROM=
# Twilio WhatsApp Business — requiere una plantilla de mensaje aprobada por
# Meta para avisos iniciados por el negocio (https://www.twilio.com/whatsapp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_TEMPLATE_SID=
# Secreto compartido para autorizar la llamada del cron de reintento
CRON_SECRET=

# TicketBAI / Batuz (Bizkaia) — ver src/lib/ticketbai/README.md.
# NOTA: este módulo es específico del sistema fiscal del País Vasco (Álava/Gipuzkoa/Bizkaia).
# No es aplicable, tal cual, a un negocio en Mallorca (Illes Balears), que tiene un sistema
# fiscal distinto — no lo actives pensando que aplica sin adaptarlo antes.
# Con TICKETBAI_ENABLED distinto de "true" (o sin poner), todo el módulo es un no-op: el
# ticket se imprime exactamente igual que hoy, sin identificativo ni QR fiscal. NO poner a
# "true" hasta tener el certificado digital del negocio y completar la firma real en
# src/lib/ticketbai/firma.ts (hoy lanza un error controlado si se activa sin firma real).
TICKETBAI_ENABLED=false
# Número de alta-inscripción TBAI, lo devuelve el registro de software de facturación TBAI al
# inscribirse (ver conversación: quién se inscribe, el negocio o Localia como autónomo).
TICKETBAI_LICENCIA=
# NIF de quien inscribió el software en el registro TBAI (la "entidad desarrolladora").
TICKETBAI_ENTIDAD_DESARROLLADORA_NIF=
TICKETBAI_SOFTWARE_NOMBRE="La Osa TPV"
TICKETBAI_SOFTWARE_VERSION=1.0
# Serie de facturación TicketBAI (numeración correlativa independiente por serie — cada
# serie lleva su propio contador, así que dos sistemas en paralelo con series distintas nunca
# chocan). Antes de activar TICKETBAI_ENABLED, confirmar que TICKETBAI_SERIE no coincide con
# ninguna serie ya usada por el TPV/POS físico del local (si usa más de una serie, p.ej. una
# por caja, comprobar todas). "WEB" se deja como valor por defecto, pero debe verificarse
# contra el TPV real del negocio antes de poner esto en producción.
TICKETBAI_SERIE=WEB
# Razón social LEGAL del negocio tal como consta en el Registro Mercantil, si difiere
# del nombre comercial (SITE.name en src/lib/constants.ts). No se ha asumido ningún valor:
# rellenar solo con el dato confirmado, nunca inventarlo.
TICKETBAI_RAZON_SOCIAL=
# NIF del emisor (el propio negocio, no la entidad desarrolladora del software de arriba).
# No se ha asumido ningún valor — rellenar solo con el dato confirmado.
TICKETBAI_NIF_EMISOR=
