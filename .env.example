# Supabase — proyecto compartido de LocalIA (ukhfaphloxlszomccgde).
# NEXT_PUBLIC_* son seguras para el navegador (clave anon, sujeta a RLS).
# La service role NUNCA debe usarse desde el navegador ni exponerse en NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Identificador público del tenant Palomita en la tabla `clientes.site_key`.
# Es seguro exponerlo (es la vía pública de acceso, ya filtrada server-side
# por las funciones RPC), pero NUNCA se usa como tenant_id de confianza.
NEXT_PUBLIC_PALOMITA_SITE_KEY=

# id interno (clientes.id) de Palomita. Solo se usa en /admin (autenticado)
# para las RPC de administración; no es un secreto, pero tampoco es la vía
# pública (esa es site_key) — no se usa nunca para autorizar nada por sí solo.
NEXT_PUBLIC_PALOMITA_CLIENTE_ID=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# URL pública del sitio (SEO, Open Graph, callbacks de Stripe, QR)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fidelización — avisos automáticos (email/WhatsApp) al otorgar un premio.
# Sin estas claves, los premios se siguen registrando y son gestionables a
# mano desde /admin/fidelizacion; simplemente no se envía el aviso.
# Secreto que verifica las llamadas entrantes al webhook de Supabase
# (restaurant.notificar_premio_otorgado) y al cron de reintento.
PROMO_WEBHOOK_SECRET=
# Resend (email) — https://resend.com
RESEND_API_KEY=
RESEND_FROM=
# Twilio WhatsApp Business — requiere una plantilla de mensaje aprobada por
# Meta para avisos iniciados por el negocio (https://www.twilio.com/whatsapp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_TEMPLATE_SID=
# Secreto compartido para autorizar la llamada del cron de reintento
CRON_SECRET=

# TicketBAI / Batuz (Bizkaia) — ver src/lib/ticketbai/README.md.
# Con TICKETBAI_ENABLED distinto de "true" (o sin poner), todo el módulo es un no-op: el
# ticket se imprime exactamente igual que hoy, sin identificativo ni QR fiscal. NO poner a
# "true" hasta tener el certificado digital de Palomita Bar SL y completar la firma real en
# src/lib/ticketbai/firma.ts (hoy lanza un error controlado si se activa sin firma real).
TICKETBAI_ENABLED=false
# Número de alta-inscripción TBAI, lo devuelve el registro de software de facturación TBAI al
# inscribirse (ver conversación: quién se inscribe, Palomita Bar SL o Localia como autónomo).
TICKETBAI_LICENCIA=
# NIF de quien inscribió el software en el registro TBAI (la "entidad desarrolladora").
TICKETBAI_ENTIDAD_DESARROLLADORA_NIF=
TICKETBAI_SOFTWARE_NOMBRE="Palomita Bar TPV"
TICKETBAI_SOFTWARE_VERSION=1.0
# Serie de facturación TicketBAI (numeración correlativa independiente por serie). Por
# defecto "A" si no se pone.
TICKETBAI_SERIE=A
# Razón social LEGAL de Palomita Bar SL tal como consta en el Registro Mercantil, si difiere
# del nombre comercial (SITE.name en src/lib/constants.ts).
TICKETBAI_RAZON_SOCIAL=
